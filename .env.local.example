NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose these in client code or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=

# AI image provider abstraction (no admin UI). Editors never choose a provider.
# Values: none | manual | openai | google | ideogram | flux | stable_diffusion
# Primary for images: google. OpenAI is automatic fallback on Google quota/429/unavailable.
AI_PROVIDER=google
# Optional future multi-vendor list (Google→OpenAI failover is automatic when primary=google)
# AI_PROVIDER_FALLBACK=openai

# Google AI Studio / Gemini image generation (server-only)
# Keep false for launch — safe-fail only until a real image generation passes QA.
GOOGLE_AI_IMAGES_ENABLED=false
GOOGLE_AI_API_KEY=
# Optional model override (default: gemini-2.5-flash-image).
# Stable image models verified against Models API: gemini-3.1-flash-image,
# gemini-3.1-flash-lite-image, gemini-3-pro-image, gemini-2.5-flash-image.
# Do not enable GOOGLE_AI_IMAGES_ENABLED until a real generate returns image bytes.
# GOOGLE_AI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI Images — automatic fallback when Google image generation fails
# (quota / billing / unavailable / HTTP 429). Server-only.
OPENAI_API_KEY=
# Optional model override (default: gpt-image-1). Example: dall-e-3
# OPENAI_IMAGE_MODEL=gpt-image-1

# Google AI text drafts for Editorial Assistant (server-only)
GOOGLE_AI_TEXT_ENABLED=false
# Optional text model (default: gemini-2.5-flash)
# GOOGLE_AI_TEXT_MODEL=gemini-2.5-flash

# Public charging map (/ladekart) — keep false until Maps + NOBIL QA pass.
CHARGING_MAP_ENABLED=false
# Optional: sync nav/hub WIP badge with server flag (true|false).
# NEXT_PUBLIC_CHARGING_MAP_ENABLED=false
# Browser Maps JS only (restrict by HTTP referrer in Google Cloud).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only NOBIL key — never NEXT_PUBLIC_*
NOBIL_API_KEY=
